  "pass_rules": {
    "premium": "every expect value within tolerance_percent / tolerance_abs",
    "standard": "every expect value within 2x tolerance",
    "smoke": "run completes, schema-valid, no VALIDATION warnings, faces/edges/openings non-empty",
    "always": "no run may fail with an unhandled error; ridge edge sum must never be rescaled when more than one ridge edge exists (fix A3)"
  }
